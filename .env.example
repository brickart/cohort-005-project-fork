# Copy to .env (gitignored). Leave the Knock keys out to stay on the local
# NotificationService. See docs/notifications-knock.md.

# Absolute base for links in Emails.
APP_URL=http://localhost:5173

# Knock Development environment, used by `npm run dev:knock`.
KNOCK_API_SECRET_KEY=
KNOCK_API_PUBLIC_KEY=
KNOCK_FEED_CHANNEL_ID=
KNOCK_SIGNING_KEY=

# Knock CLI, used by `npm run knock:push`.
KNOCK_SERVICE_TOKEN=
