{
  "name": "Course status changed",
  "description": "Tells a course's Instructor that an Admin published or archived it.",
  "steps": [
    {
      "type": "channel",
      "template": {
        "subject": "{{ data.course_title }} was {{ data.status }}",
        "settings": {
          "layout_key": "default",
          "attachment_key": "attachments"
        },
        "text_body@": "email_1/text_body.txt",
        "html_body@": "email_1/html_body.html"
      },
      "ref": "email_1",
      "channel_type": "email",
      "channel_key": "knock-email"
    },
    {
      "type": "channel",
      "template": {
        "action_url": "{{ data.action_url }}",
        "markdown_body@": "in_app_feed_1/markdown_body.md"
      },
      "ref": "in_app_feed_1",
      "channel_type": "in_app_feed",
      "channel_key": "in-app"
    }
  ],
  "categories": [
    "cadence"
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "course-status-changed",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
